{
  "expo": {
    "name": "GymLevel",
    "slug": "gymlevel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "gymlevel",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymlevel.app"
    },
    "android": {
      "package": "com.gymlevel.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/GymLevel"
    }
  }
}
