{
  "expo": {
    "name": "GymLevel",
    "slug": "gymlevel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "gymlevel",
    "newArchEnabled": true,
    "backgroundColor": "#020617",
    "primaryColor": "#22d3ee",

    "icon": "./assets/icon.png",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },

    "privacyPolicyUrl": "https://amixem10.github.io/GymLevel/privacy",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymlevel.app",
      "buildNumber": "1",
      "appleTeamId": "",
      "backgroundColor": "#020617",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "GymLevel utilise les notifications pour vous rappeler vos séances, le rechargement des quêtes quotidiennes et vos alertes de récupération musculaire.",
        "NSHealthShareUsageDescription": "GymLevel lit vos données de santé pour personnaliser vos scores de récupération.",
        "NSHealthUpdateUsageDescription": "GymLevel enregistre vos séances dans l'app Santé pour un suivi centralisé."
      }
    },

    "android": {
      "package": "com.gymlevel.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },

    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#22d3ee",
          "sounds": [],
          "androidCollapsedTitle": "GymLevel",
          "iosDisplayInForeground": true
        }
      ]
    ],

    "web": {
      "bundler": "metro",
      "output": "static",
      "backgroundColor": "#020617",
      "themeColor": "#020617",
      "name": "GymLevel",
      "shortName": "GymLevel",
      "display": "standalone",
      "favicon": "./assets/favicon.png",
      "meta": {
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "black-translucent",
        "mobile-web-app-capable": "yes",
        "theme-color": "#020617",
        "viewport": "width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover"
      }
    },

    "updates": {
      "fallbackToCacheTimeout": 0
    },

    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/GymLevel"
    }
  }
}
