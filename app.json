{
  "expo": {
    "name": "GymLevel",
    "slug": "gymlevel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "gymlevel",
    "newArchEnabled": true,
    "backgroundColor": "#020617",
    "primaryColor": "#22d3ee",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymlevel.app",
      "backgroundColor": "#020617"
    },
    "android": {
      "package": "com.gymlevel.app",
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "backgroundColor": "#020617",
      "themeColor": "#020617",
      "name": "GymLevel",
      "shortName": "GymLevel",
      "display": "standalone",
      "meta": {
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "black-translucent",
        "mobile-web-app-capable": "yes",
        "theme-color": "#020617",
        "viewport": "width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/GymLevel"
    }
  }
}
